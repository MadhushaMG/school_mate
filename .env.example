# Server Port
PORT=5000

# Environment (development | production)
NODE_ENV=development

# PostgreSQL Connection String (e.g. Neon, Supabase, or local PostgreSQL)
# Example Neon: postgresql://username:password@ep-cool-cloud-123456.us-east-2.aws.neon.tech/schoolmate?sslmode=require
# Example Local: postgresql://postgres:postgres@localhost:5432/schoolmate?schema=public
DATABASE_URL=""

# JWT Secrets
JWT_SECRET=schoolmate_default_jwt_secret_key_2026
JWT_EXPIRES_IN=7d

# CORS
CLIENT_ORIGIN=*

# SMTP Mail Configuration (Optional for password resets)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
